# ╔════════════════════════════════════════════════════════════════════════╗
# ║  ⚠️  DO NOT COPY THIS FILE TO THE SERVER.                              ║
# ║                                                                        ║
# ║  cPanel → Setup Node.js App writes the real .htaccess into the app     ║
# ║  root, with the paths of THAT account. The paths below belong to a      ║
# ║  different account on a different server and are kept only as a         ║
# ║  reference for the directive shape.                                     ║
# ║                                                                        ║
# ║  Overwriting the server's .htaccess with this one makes Passenger/      ║
# ║  LiteSpeed unable to find the app → 503, site down.                     ║
# ║                                                                        ║
# ║  `.cpanel.yml` deliberately does NOT copy this file. Keep it that way.  ║
# ╚════════════════════════════════════════════════════════════════════════╝
#
# Reference only — actual values are generated per account by cPanel:
#   PassengerAppRoot      "/home2/<account>/repositories/rentride/backend"
#   PassengerBaseURI      "/"
#   PassengerNodejs       "/home2/<account>/nodevenv/repositories/rentride/backend/22/bin/node"
#   PassengerAppType      node
#   PassengerStartupFile  server.js

# ─── Disable LiteSpeed page cache (LSCache) for the SPA ───
# Without this, LiteSpeed serves a stale cached copy of index.html for hours,
# ignoring file mtime and Cache-Control entirely.
<IfModule LiteSpeed>
    CacheDisable public /
    RewriteEngine On
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# NOTE: canonical-host redirect and security headers are NOT here.
#   - Canonical host (www → non-www, http → https): Express middleware in
#     backend/server.js. LiteSpeed routes every request to the Node app, so a
#     rewrite here would never run.
#   - Security headers: already set by `helmet` in backend/server.js.
# They were briefly duplicated here and had no effect. Don't re-add them.

<IfModule mod_headers.c>
    # Long-lived immutable cache for hashed JS/CSS/font/img assets.
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # NEVER cache the HTML entry point — its content references hashed
    # bundles that change on each deploy.
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# SPA fallback — non-API, non-file paths go to index.html so React Router
# can handle them.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite real files / directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite API requests — Passenger handles them.
    RewriteRule ^api/ - [L]

    # Everything else → index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Compress text responses.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
