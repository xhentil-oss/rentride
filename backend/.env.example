# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=production

# ============================================
# DATABASE — MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=rental_user
DB_PASSWORD=your_strong_password_here
DB_NAME=rental_db

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# EMAIL (NodeMailer)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=Rent Ride <your@gmail.com>
# Where new-booking notifications are sent (admin/staff inbox).
# If unset, falls back to MAIL_USER.
ADMIN_EMAIL=admin@rentride.al

# ============================================
# GOOGLE SIGN-IN
# ============================================
# Web application client ID from Google Cloud Console.
# Use the same value as root .env VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ============================================
# FRONTEND URL (CORS)
# ============================================
FRONTEND_URL=https://yourdomain.com
